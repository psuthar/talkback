# Local credentials for the FULL_AUTO orchestration scripts (SCRUM-528).
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Then `source .env.local` before running scripts, or use direnv.
#
# See docs/agent/full-auto-scripts.md for the full setup runbook.

# ── Jira (Atlassian) ──────────────────────────────────────────────────────────
#
# Required. The FULL_AUTO scripts use Basic auth against the Atlassian REST API.
# Generate a SCOPED token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Recommended scopes: read:jira-work + write:jira-work
# Recommended expiry: 90 days
#
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=ATATT3xFfGF0...

# Optional. Defaults to https://suthar-team.atlassian.net.
# Override if you're testing against a different tenant.
#
# ATLASSIAN_BASE_URL=https://suthar-team.atlassian.net

# ── GitHub ────────────────────────────────────────────────────────────────────
#
# NOT required locally — the scripts fall back to `gh auth token` if this is
# unset. Only set GITHUB_TOKEN here for:
#   - CI / webhook environments where gh CLI isn't available
#   - Explicit override (e.g., testing with a service account token)
#
# GITHUB_TOKEN=ghp_...
