{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TalkBack API",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "BIND_ADDRESS": "127.0.0.1",
                "PATH": "/opt/homebrew/bin:${env:PATH}"
            },
            "args": [],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal",
            "debugAdapter": "legacy"
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 0,
            "showLog": true,
            "debugAdapter": "legacy"
        },
        {
            "name": "Debug Tests (Current Package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "TEST_DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable"
            },
            "args": [
                "-test.v",
                "-test.paniconexit0",
                "-p",
                "1"
            ],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal",
            "debugAdapter": "legacy"
        },
        {
            "name": "Debug Tests (All)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "TEST_DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable"
            },
            "args": [
                "-test.v",
                "-test.paniconexit0",
                "-test.timeout",
                "30s",
                "-p",
                "1"
            ],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal",
            "debugAdapter": "legacy"
        },
        {
            "name": "Debug Current Test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "TEST_DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable"
            },
            "args": [
                "-test.v",
                "-test.run",
                "^${input:testName}$",
                "-p",
                "1"
            ],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal",
            "debugAdapter": "legacy"
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "Enter test name (e.g., TestCreateArtifact)",
            "default": ""
        }
    ]
}
