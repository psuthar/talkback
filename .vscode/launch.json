{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TalkBack API",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api",
            "cwd": "${workspaceFolder}",
            "env": {
                "PORT": "8080",
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "BIND_ADDRESS": "127.0.0.1",
                "TALKBACK_UPLOAD_ROOT": "${workspaceFolder}",
                "TALKBACK_SOFFICE_CMD": "${workspaceFolder}/scripts/soffice-docker.cmd",
                "WHISPER_CLI": "C:\\\\Users\\\\pares\\\\AppData\\\\Local\\\\Python\\\\pythoncore-3.14-64\\\\Scripts\\\\whisper.exe",
                "FFMPEG_BIN_DIR": "C:\\\\Users\\\\pares\\\\AppData\\\\Local\\\\Microsoft\\\\WinGet\\\\Packages\\\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\\\ffmpeg-8.0.1-full_build\\\\bin"
            },
            "args": [],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug TalkBack API (with .env file)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PORT": "8080",
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "BIND_ADDRESS": "127.0.0.1",
                "TALKBACK_UPLOAD_ROOT": "${workspaceFolder}",
                "TALKBACK_SOFFICE_CMD": "${workspaceFolder}/scripts/soffice-docker.cmd",
                "WHISPER_CLI": "C:\\\\Users\\\\pares\\\\AppData\\\\Local\\\\Python\\\\pythoncore-3.14-64\\\\Scripts\\\\whisper.exe",
                "FFMPEG_BIN_DIR": "C:\\\\Users\\\\pares\\\\AppData\\\\Local\\\\Microsoft\\\\WinGet\\\\Packages\\\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\\\ffmpeg-8.0.1-full_build\\\\bin"
            },
            "args": [],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 0,
            "showLog": true
        },
        {
            "name": "Debug Tests (Current Package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "cwd": "${workspaceFolder}",
            "env": {
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "TEST_DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable"
            },
            "args": [
                "-test.v",
                "-test.paniconexit0",
                "-p",
                "1"
            ],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Tests (All)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "env": {
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "TEST_DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable"
            },
            "args": [
                "-test.v",
                "-test.paniconexit0",
                "-test.timeout",
                "30s",
                "-p",
                "1"
            ],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Current Test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "cwd": "${workspaceFolder}",
            "env": {
                "DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable",
                "TEST_DATABASE_URL": "postgres://talkback:talkback@127.0.0.1:5432/talkback?sslmode=disable"
            },
            "args": [
                "-test.v",
                "-test.run",
                "^${input:testName}$",
                "-p",
                "1"
            ],
            "showLog": true,
            "trace": "log",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "Enter test name (e.g., TestCreateArtifact)",
            "default": ""
        }
    ]
}

