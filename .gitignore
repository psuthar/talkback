# Claude Code
.claude/worktrees/
.claude/settings.local.json

# Environment variables
.env
web/.env.e2e
web/.env.e2e.local

# Data directory (uploaded files)
data/

# Local sessions (e.g. dev)
sessions/

# Temp dir for slide conversion when using TALKBACK_SOFFICE_CMD (Docker wrapper)
.tmp/

# Python (release-readiness scripts, local tooling)
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.venv/
venv/

# Go
*.exe
*.exe~
**/__debug_bin*
*.dll
*.so
*.dylib
*.test
*.out
go.work

# Cursor MCP config (may contain GitHub PAT)
.cursor/mcp.json

# IDE
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~

# Observability worker output (keep ops/bundles/ via .gitkeep)
ops/bundles/*
ops/bundles/*.md
ops/bundles/*.json
!ops/bundles/.gitkeep

# Baseline storage (keep ops/baselines/ via .gitkeep)
ops/baselines/*.json
!ops/baselines/.gitkeep

# Test output (e.g. Playwright)
test-results/

# OS
.DS_Store
Thumbs.db

# Embedded SPA build output (copied during Docker build; keep a tiny placeholder checked in)
cmd/api/dist/*
!cmd/api/dist/index.html

# Release readiness generated reports (keep .gitkeep placeholders)
artifacts/release-readiness/*
!artifacts/release-readiness/.gitkeep
artifacts/release-readiness-fixture-test/
artifacts/rr-test/

