# Claude Code
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Top-level git worktree directory (complement to .claude/worktrees/)
.worktrees/

# Cursor IDE plan drafts (personal working docs)
.cursor/plans/

# Epic-run agent state files (transient; may contain API tokens in PR URLs)
.epic-run/

# Paperclip agent artifacts (transient; used only during execution runs)
plan.md
plan.json

# Environment variables
.env
.env.local
web/.env.e2e
web/.env.e2e.local

# Data directory (uploaded files)
data/

# Local sessions (e.g. dev)
sessions/

# Temp dir for slide conversion when using TALKBACK_SOFFICE_CMD (Docker wrapper)
.tmp/

# Python (release-readiness scripts, local tooling)
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.venv/
venv/

# Go
*.exe
*.exe~
**/__debug_bin*
*.dll
*.so
*.dylib
*.test
*.out
go.work
talkback-mcp

# MCP configs (may contain API tokens/secrets)
.mcp.json
.cursor/mcp.json
# Persists TALKBACK_MCP_URL / TALKBACK_MCP_API_KEY for setup-mcp-config.sh re-runs
.env.mcp

# Local draft PR body (CLAUDE.md §7); prefer GitHub MCP for PR creation—do not commit by accident
pr-body.md

# IDE
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
*.swp
*.swo
*~

# Observability worker output (keep ops/bundles/ via .gitkeep)
ops/bundles/*
ops/bundles/*.md
ops/bundles/*.json
!ops/bundles/.gitkeep

# Baseline storage (keep ops/baselines/ via .gitkeep)
ops/baselines/*.json
!ops/baselines/.gitkeep

# Q&A eval runner outputs (timestamped); keep directory via .gitkeep
eval/qa/runs/*
!eval/qa/runs/.gitkeep

# Test output (e.g. Playwright)
test-results/
playwright-results.json
# Local Playwright HTML report (`npx playwright test` / `npm run test:e2e`); CI uploads reports via workflow artifacts, not this tree
playwright-report/

# Untracked root-level artifact (do not match cmd/api)
/api

# OS
.DS_Store
Thumbs.db

# Embedded SPA build output (copied during Docker build; keep a tiny placeholder checked in)
cmd/api/dist/*
!cmd/api/dist/index.html

# Release readiness generated reports (keep .gitkeep placeholders)
artifacts/release-readiness/*
!artifacts/release-readiness/.gitkeep
artifacts/release-readiness-fixture-test/
artifacts/rr-test/
artifacts/gap-test/

# Local pr-risk script output (reproducible via scripts/pr_risk_run.py)
artifacts/pr-risk.json
artifacts/release-readiness.json

# npm package install output (root-level cache; web/node_modules already implicit)
node_modules/

