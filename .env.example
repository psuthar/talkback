# --- Where to put local dev values (Zoom, Teams, secrets) -------------------
# Put app secrets and OAuth settings in THIS FILE (.env), not in .vscode/launch.json.
# .env is gitignored. launch.json only overrides a few debugger paths (e.g. WHISPER_CLI).
# If a variable appears in BOTH launch.json "env" and .env, the debugger wins for that key.
# Microsoft Teams: same pattern as Zoom — ENABLE_TEAMS, TEAMS_CLIENT_ID, TEAMS_CLIENT_SECRET,
# TEAMS_REDIRECT_URL (must match Azure app redirect URI), TEAMS_TENANT_ID, all below.
# ----------------------------------------------------------------------------

DATABASE_URL=postgres://talkback:talkback@localhost:5432/talkback?sslmode=disable
OPENAI_API_KEY=your_openai_api_key_here
RUN_MIGRATIONS=true
PORT=8080

# Zoom OAuth (for Connect Zoom and Create session from Zoom)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
BASE_URL=http://localhost:8080
# Optional: where to redirect after OAuth when API and app are different origins
APP_REDIRECT_URL=
# Zoom OAuth scopes. Default includes both required for transcript import:
#   cloud_recording:read:list_user_recordings - list user's recordings
#   cloud_recording:read:list_recording_files - fetch meeting recording details (API 4711 without this)
# Add both in Zoom Marketplace app → Scopes tab.
# ZOOM_OAUTH_SCOPES=cloud_recording:read:list_user_recordings cloud_recording:read:list_recording_files user:read

# Microsoft Teams (optional). Configure here (same as Zoom). TEAMS_REDIRECT_URL must be an absolute URL
# registered in Azure Entra (e.g. http://localhost:8080/auth/teams/callback — use the same host/port as your API).
# ENABLE_TEAMS=true
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_REDIRECT_URL=
# TEAMS_TENANT_ID=
# In Azure: App registration → API permissions → Microsoft Graph → Delegated: add the same names as below, then Grant admin consent if required.
# Include Calendars.Read (calendar join URLs → online meetings) and Files.Read (list MP4s under OneDrive "Microsoft Teams Recordings" for chat meetings).
# Optional: override scopes (space-separated). Defaults use Graph names OnlineMeetingRecording.Read.All and OnlineMeetingTranscript.Read.All (not *.Read).
# TEAMS_OAUTH_SCOPES=
# If OneDrive uses a localized folder name for Teams recordings, set exact name(s) comma-separated (we only list inside these folders, not whole-drive search).
# TEAMS_ONEDRIVE_RECORDINGS_FOLDER=

# Token encryption (Zoom) and accept-token signing (incognito/re-login). Use ONE of these:
# - ENCRYPTION_KEY: required if you use Zoom OAuth; also used for accept tokens if ACCEPT_TOKEN_SECRET is unset.
#   Use a long random secret (e.g. 32+ chars). Generate one: openssl rand -base64 32
# - ACCEPT_TOKEN_SECRET: used only for short-lived Bearer tokens (invite/incognito). Any long random string.
# If both are set, accept tokens use ACCEPT_TOKEN_SECRET. On Render: set at least one (e.g. ENCRYPTION_KEY) in the API service env.
ENCRYPTION_KEY=default-key-change-in-production

# TalkBack auth (users + login sessions)
# TB_SESSION_COOKIE_NAME=tb_login
# TB_SESSION_TTL_HOURS=168
# TB_COOKIE_DOMAIN=   (optional; omit on Render)
# TB_COOKIE_SECURE=false   (true on Render when ENV=production)
# Bootstrap admin: create admin user at startup when DB is empty (e.g. after reset). Both required for auto-create.
# TALKBACK_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# TALKBACK_BOOTSTRAP_ADMIN_PASSWORD=your-secure-password
# TB_ALLOWED_ORIGINS=   (optional; split-origin only — comma list for auth Origin check + SameSite=None cookie; omit for unified SPA+API)

# CORS_ALLOWED_ORIGINS=   (optional; split-origin / tools — API CORS allowlist; same list feeds TB cookie mode when TB_ALLOWED_ORIGINS unset)
# Local dev with Vite proxy (same-origin to :3000): usually omit both. Direct browser→API on another port: set to frontend origin, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Invitations (mailto or Resend). Base URL for accept-invite links = frontend (web app) origin where /accept-invite is served.
# Do NOT set this to the API URL. On Render: set this on the API service to your web app URL (e.g. https://talkback-ux.onrender.com).
# Defaults to http://localhost:3000 if unset.
# APP_BASE_URL=http://localhost:3000
# APP_BASE_URL=https://talkback-ux.onrender.com
# Optional: send invite emails via Resend instead of opening mailto draft.
# RESEND_API_KEY=
# INVITE_EXPIRY_HOURS=168
# Optional override for accept-token signing only (incognito/re-login). If unset, ENCRYPTION_KEY is used.
# ACCEPT_TOKEN_SECRET=

# Dev-only: Enable reset endpoint (âš ï¸ WARNING: Allows deletion of all data)
ALLOW_DEV_RESET=false
DEV_RESET_DELETE_FILES=false

# R2 storage (presigned PUT/GET for all file uploads and playback)
STORAGE_DRIVER=r2
R2_BUCKET=talkback-r2-bucket
R2_ACCOUNT_ID=5a40397eb6f38a6e7780da2e4f957192
R2_ENDPOINT=https://5a40397eb6f38a6e7780da2e4f957192.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=__set_me__
R2_SECRET_ACCESS_KEY=__set_me__
R2_PREFIX=talkback/
R2_PRESIGN_PUT_TTL_SECONDS=900
R2_PRESIGN_GET_TTL_SECONDS=3600
PUBLIC_APP_ORIGIN=http://localhost:8081

# Upload and per-session caps (tune for demo vs production; see docs/storage-r2.md)
MAX_UPLOAD_BYTES_DEFAULT=262144000
MAX_UPLOAD_BYTES_VIDEO=1073741824
MAX_SESSION_ARTIFACTS=50

# Demo limit: max Zoom recording duration in seconds (default 600 = 10 minutes). Imports over this are rejected.
ZOOM_MAX_VIDEO_DURATION_SECONDS=600

# New Relic APM (optional). Use exact names NEW_RELIC_LICENSE_KEY and NEW_RELIC_APP_NAME.
# Omit both to disable; deploy works either way. If set, init has a 5s timeout so startup is not blocked.
# NEW_RELIC_LICENSE_KEY=your_license_key
# NEW_RELIC_APP_NAME=Talkback-NewRelic

# Fault injection for observability testing (test-only; see ops/observability/FAULT_TESTING.md)
# OBS_TEST_MODE=false   (must be true to enable /debug/fault/* routes)
# OBS_TEST_TOKEN=       (optional; when set, require X-Obs-Test-Token header)
