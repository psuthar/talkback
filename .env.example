DATABASE_URL=postgres://talkback:talkback@localhost:5432/talkback?sslmode=disable
OPENAI_API_KEY=your_openai_api_key_here
RUN_MIGRATIONS=true
PORT=8080

# Zoom OAuth (for Connect Zoom and Create session from Zoom)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
BASE_URL=http://localhost:8080
# Optional: where to redirect after OAuth when API and app are different origins
APP_REDIRECT_URL=
# Zoom OAuth scopes. Default includes both required for transcript import:
#   cloud_recording:read:list_user_recordings - list user's recordings
#   cloud_recording:read:list_recording_files - fetch meeting recording details (API 4711 without this)
# Add both in Zoom Marketplace app → Scopes tab.
# ZOOM_OAUTH_SCOPES=cloud_recording:read:list_user_recordings cloud_recording:read:list_recording_files user:read

# Token encryption (required for Zoom; use a 32-byte hex or base64 key in production)
ENCRYPTION_KEY=default-key-change-in-production

# TalkBack auth (users + login sessions)
# TB_SESSION_COOKIE_NAME=tb_login
# TB_SESSION_TTL_HOURS=168
# TB_COOKIE_DOMAIN=   (optional; omit on Render)
# TB_COOKIE_SECURE=false   (true on Render when ENV=production)
# TALKBACK_BOOTSTRAP_ADMIN_EMAIL=   (if set, first user with this email gets global_role=admin)
# TB_ALLOWED_ORIGINS=   (comma list for origin check on auth routes; e.g. http://localhost:3000,https://your-app.onrender.com)

# CORS: required for login from a different port (e.g. frontend on 3000, API on 8081). Set to your frontend origin.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Dev-only: Enable reset endpoint (âš ï¸ WARNING: Allows deletion of all data)
ALLOW_DEV_RESET=false
DEV_RESET_DELETE_FILES=false
