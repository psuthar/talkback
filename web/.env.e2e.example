# Copy to .env.e2e and run: npm run test:e2e:render
# Used only when E2E_TARGET=render (not for npm run test:e2e). .env.e2e is gitignored.
# API (microservice)
TALKBACK_API_BASE=https://talkback-895n.onrender.com
# App (frontend)
E2E_BASE_URL=https://talkback-ux.onrender.com

# Split-origin E2E (separate API + app hosts): on the API service, e.g.:
#   TB_COOKIE_SECURE=1   (exact name — not TB_SECURE_COOKIE)
#   TB_ALLOWED_ORIGINS=https://talkback-ux.onrender.com
# Do not set TB_COOKIE_DOMAIN. API logs: "SameSite=None" when allowlist is set.
# Unified same-origin deploy: omit TB_ALLOWED_ORIGINS/CORS — logs show same-origin / Lax mode.
