# API base URL for the TalkBack backend (Vite injects at build time).
# Local dev: leave unset for same-origin-relative paths (Vite proxy -> API).
# Production (unified Render web service, SPA+API same origin): leave unset.
# Override only for unusual setups (e.g. browser hitting a different API host than the page).
#VITE_API_BASE_URL=http://localhost:8080

# --- Playwright E2E + run-e2e-local.sh (copy to web/.env; file is gitignored) ---
# Must match the admin user your local API uses (bootstrap or first admin in DB).
# scripts/run-e2e-local.sh sources web/.env with the shell — values with spaces or special
# characters must be single-quoted (e.g. TALKBACK_BOOTSTRAP_ADMIN_DISPLAY_NAME='Pat Example').
#TALKBACK_BOOTSTRAP_ADMIN_EMAIL=you@example.com
#TALKBACK_BOOTSTRAP_ADMIN_PASSWORD=your-password
#TALKBACK_BOOTSTRAP_ADMIN_DISPLAY_NAME='Local Admin'
#TALKBACK_ADMIN_EMAIL=you@example.com
#TALKBACK_ADMIN_PASSWORD=your-password
#TALKBACK_API_BASE=http://localhost:8080
