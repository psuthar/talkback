{
  "name": "talkback-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first playwright test",
    "test:e2e:local": "bash ../scripts/run-e2e-local.sh",
    "test:e2e:render": "cross-env E2E_TARGET=render NODE_OPTIONS=--dns-result-order=ipv4first playwright test",
    "test:e2e:ui": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first playwright test --ui",
    "test:e2e:headed": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first playwright test --headed"
  },
  "dependencies": {
    "mammoth": "^1.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.1",
    "vite": "^5.0.8",
    "vitest": "^4.1.1"
  }
}
